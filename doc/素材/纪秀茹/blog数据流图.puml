@startuml DFD-0顶层图
skinparam defaultFontName "Microsoft YaHei"
skinparam rectangle {
  BackgroundColor #FEFEFE
  BorderColor black
}
skinparam circle {
  BackgroundColor #E8F4FD
  BorderColor #1565C0
}
title 图0  DjangoBlog系统 数据流图（顶层图/上下文图）

' ===== 外部实体 =====
rectangle "读者\n(Guest)" as E1 #FFE0B2
rectangle "作者\n(Author)" as E2 #C8E6C9
rectangle "管理员\n(Admin)" as E3 #F8BBD0
rectangle "OAuth服务商\n(GitHub/微博/QQ)" as E4 #E1BEE7

' ===== 中心处理 =====
circle "0\nDjangoBlog\n博客系统" as P0 #BBDEFB

' ===== 数据流 =====
E1 --> P0 : 浏览请求(首页/详情/分类/标签/归档/搜索)
E1 --> P0 : 评论内容/表情反应
P0 --> E1 : 文章列表/文章详情/评论列表/归档结果

E2 --> P0 : 文章内容/分类标签设置/图片上传
P0 --> E2 : 编辑表单/保存结果提示

E3 --> P0 : 站点配置/友链/侧边栏/审核操作
P0 --> E3 : 管理界面数据/操作结果

E4 <--> P0 : 授权请求/用户信息
@enduml


@startuml DFD-1前台文章浏览
skinparam defaultFontName "Microsoft YaHei"
skinparam rectangle {
  BackgroundColor #FEFEFE
  BorderColor black
}
title 图1.0  前台文章浏览 数据流图（1层分解）

' ===== 外部实体 =====
rectangle "读者\n(Guest)" as E1 #FFE0B2

' ===== 处理过程 =====
rectangle "1.1\n展示文章列表\n(首页/分页)" as P11 #E8F4FD
rectangle "1.2\n展示文章详情" as P12 #E8F4FD
rectangle "1.3\n分类/标签筛选" as P13 #E8F4FD
rectangle "1.4\n时间归档查询" as P14 #E8F4FD

' ===== 数据存储 =====
database "D1\nArticle表" as D1 #FFF9C4
database "D2\nCategory表" as D2 #FFF9C4
database "D3\nTag表" as D3 #FFF9C4
database "D4\nComment表" as D4 #FFF9C4

' ===== 数据流 =====
E1 --> P11 : 浏览首页请求
P11 --> D1 : 查询已发布文章列表
D1 --> P11 : 返回文章数据
P11 --> E1 : 渲染文章列表页

E1 --> P12 : 点击文章(文章ID)
P12 --> D1 : 按ID查询文章详情
D1 --> P12 : 返回文章正文
P12 --> D4 : 查询该文章评论
D4 --> P12 : 返回评论列表
P12 --> E1 : 渲染文章详情页(正文+评论)

E1 --> P13 : 选择分类/标签
P13 --> D2 : 查询分类下文章
P13 --> D3 : 查询标签下文章
D2 --> P13 : 返回分类文章
D3 --> P13 : 返回标签文章
P13 --> E1 : 渲染分类/标签页

E1 --> P14 : 查看归档
P14 --> D1 : 按时间查询全部文章
D1 --> P14 : 返回归档数据
P14 --> E1 : 渲染归档时间轴
@enduml


@startuml DFD-2文章内容管理
skinparam defaultFontName "Microsoft YaHei"
skinparam rectangle {
  BackgroundColor #FEFEFE
  BorderColor black
}
title 图2.0  文章内容管理 数据流图（1层分解）

' ===== 外部实体 =====
rectangle "作者\n(Author)" as E2 #C8E6C9

' ===== 处理过程 =====
rectangle "2.1\n撰写/编辑文章" as P21 #E8F4FD
rectangle "2.2\n上传文章图片" as P22 #E8F4FD
rectangle "2.3\n删除文章" as P23 #E8F4FD

' ===== 数据存储 =====
database "D1\nArticle表" as D1 #FFF9C4
database "D2\nCategory表" as D2 #FFF9C4
database "D3\nTag表" as D3 #FFF9C4
file "图片文件\n(media/)" as F1 #FFCCBC

' ===== 数据流 =====
E2 --> P21 : 填写标题/正文/选择分类标签
P21 --> D2 : 读取可选分类列表
D2 --> P21 : 返回分类数据
P21 --> D3 : 读取可选标签列表
D3 --> P21 : 返回标签数据
P21 --> D1 : 保存/更新文章记录
D1 --> P21 : 返回文章ID
P21 --> E2 : 保存成功提示

E2 --> P22 : 上传图片文件
P22 --> F1 : 存储图片到media目录
F1 --> P22 : 返回图片URL
P22 --> E2 : 返回图片URL(插入正文)

E2 --> P23 : 删除文章请求
P23 --> D1 : 按ID删除文章记录
D1 --> P23 : 删除确认
P23 --> E2 : 删除成功提示
@enduml


@startuml DFD-3评论互动
skinparam defaultFontName "Microsoft YaHei"
skinparam rectangle {
  BackgroundColor #FEFEFE
  BorderColor black
}
title 图3.0  评论互动 数据流图（1层分解）

' ===== 外部实体 =====
rectangle "读者\n(Guest)" as E1 #FFE0B2
rectangle "管理员\n(Admin)" as E3 #F8BBD0

' ===== 处理过程 =====
rectangle "3.1\n发表评论" as P31 #E8F4FD
rectangle "3.2\n评论表情反应" as P32 #E8F4FD
rectangle "3.3\n审核评论" as P33 #E8F4FD

' ===== 数据存储 =====
database "D4\nComment表" as D4 #FFF9C4
database "D5\nCommentReaction表" as D5 #FFF9C4
database "D6\nBlogUser表" as D6 #FFF9C4

' ===== 数据流 =====
E1 --> P31 : 提交评论内容+文章ID
P31 --> D6 : 校验用户身份
D6 --> P31 : 返回用户信息
P31 --> D4 : 保存评论记录(待审核)
D4 --> P31 : 返回评论ID
P31 --> E1 : 评论提交成功提示

E1 --> P32 : 选择表情(点赞/爱心等)
P32 --> D5 : 保存表情反应记录
D5 --> P32 : 返回反应统计
P32 --> E1 : 更新评论反应数

E3 --> P33 : 查看待审核评论
P33 --> D4 : 查询is_enable=False的评论
D4 --> P33 : 返回待审评论列表
E3 --> P33 : 通过/屏蔽操作
P33 --> D4 : 更新评论is_enable状态
D4 --> P33 : 更新确认
P33 --> E3 : 审核结果提示
@enduml


@startuml DFD-4分类标签友链维护
