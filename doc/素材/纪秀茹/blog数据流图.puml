rectangle "4.2\n维护标签" as P42 #E8F4FD
rectangle "4.3\n维护友情链接" as P43 #E8F4FD
rectangle "4.4\n维护侧边栏" as P44 #E8F4FD

' ===== 数据存储 =====
database "D2\nCategory表" as D2 #FFF9C4
database "D3\nTag表" as D3 #FFF9C4
