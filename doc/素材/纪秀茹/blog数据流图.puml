@startuml DFD-0顶层图
skinparam defaultFontName "Microsoft YaHei"
skinparam nodesep 80
skinparam ranksep 100
skinparam rectangle {
  BackgroundColor white
  BorderColor black
  FontSize 13
}
skinparam ArrowFontSize 11
skinparam ArrowColor black
skinparam Shadowing false
title 图0  DjangoBlog系统 数据流图（顶层图）

rectangle "读者\n(Guest)" as E1
rectangle "作者\n(Author)" as E2
rectangle "管理员\n(Admin)" as E3
rectangle "OAuth\n服务商" as E4
usecase "博客系统" as P0

E1 --> P0 : 浏览请求/评论内容
P0 --> E1 : 文章详情/评论列表
E2 --> P0 : 文章内容/图片上传
P0 --> E2 : 编辑表单/保存结果
E3 --> P0 : 配置/友链/审核操作
P0 --> E3 : 管理界面/操作结果
E4 --> P0 : 授权请求
P0 --> E4 : 用户信息
@enduml

@startuml DFD-1前台文章浏览
skinparam defaultFontName "Microsoft YaHei"
skinparam nodesep 50
skinparam ranksep 70
skinparam rectangle {
  BackgroundColor white
  BorderColor black
  FontSize 12
}
skinparam ArrowFontSize 10
skinparam ArrowColor black
title 图1.0  前台文章浏览 数据流图（1层分解）

rectangle "读者" as E1

usecase "1.1\n文章列表" as P11
usecase "1.2\n文章详情" as P12
usecase "1.3\n分类标签筛选" as P13
usecase "1.4\n时间归档" as P14

rectangle "D1\nArticle" as D1
rectangle "D2\nCategory" as D2
rectangle "D3\nTag" as D3
rectangle "D4\nComment" as D4

E1 --> P11 : 首页请求
P11 --> D1 : 查询已发布文章
D1 --> P11 : 文章数据
P11 --> E1 : 列表页

E1 --> P12 : 点击文章
P12 --> D1 : 按ID查文章
D1 --> P12 : 正文
P12 --> D4 : 查评论
D4 --> P12 : 评论列表
P12 --> E1 : 详情页

E1 --> P13 : 选分类/标签
P13 --> D2 : 分类文章
P13 --> D3 : 标签文章
D2 --> P13 : 分类数据
D3 --> P13 : 标签数据
P13 --> E1 : 筛选结果

E1 --> P14 : 查看归档
P14 --> D1 : 按时间查文章
D1 --> P14 : 归档数据
P14 --> E1 : 时间轴
@enduml

@startuml DFD-2文章内容管理
skinparam defaultFontName "Microsoft YaHei"
skinparam nodesep 50
skinparam ranksep 70
skinparam rectangle {
  BackgroundColor white
  BorderColor black
  FontSize 12
}
skinparam ArrowFontSize 10
skinparam ArrowColor black
title 图2.0  文章内容管理 数据流图（1层分解）

rectangle "作者" as E2

usecase "2.1\n撰写编辑文章" as P21
usecase "2.2\n上传图片" as P22
usecase "2.3\n删除文章" as P23

rectangle "D1\nArticle" as D1
rectangle "D2\nCategory" as D2
rectangle "D3\nTag" as D3
rectangle "F1\n图片文件" as F1

E2 --> P21 : 标题/正文/分类标签
P21 --> D2 : 读分类列表
D2 --> P21 : 分类数据
P21 --> D3 : 读标签列表
D3 --> P21 : 标签数据
P21 --> D1 : 保存文章
D1 --> P21 : 返回文章ID
P21 --> E2 : 保存成功

E2 --> P22 : 上传图片
P22 --> F1 : 存图片文件
F1 --> P22 : 返回图片URL
P22 --> E2 : 图片URL

E2 --> P23 : 删除请求
P23 --> D1 : 删除文章记录
D1 --> P23 : 删除确认
P23 --> E2 : 删除成功
@enduml

@startuml DFD-3评论互动
skinparam defaultFontName "Microsoft YaHei"
skinparam nodesep 50
skinparam ranksep 70
skinparam rectangle {
  BackgroundColor white
  BorderColor black
  FontSize 12
}
skinparam ArrowFontSize 10
skinparam ArrowColor black
title 图3.0  评论互动 数据流图（1层分解）

rectangle "读者" as E1
rectangle "管理员" as E3

usecase "3.1\n发表评论" as P31
usecase "3.2\n表情反应" as P32
usecase "3.3\n审核评论" as P33

rectangle "D4\nComment" as D4
rectangle "D5\nCommentReaction" as D5
rectangle "D6\nBlogUser" as D6

E1 --> P31 : 评论内容+文章ID
P31 --> D6 : 校验用户
D6 --> P31 : 用户信息
P31 --> D4 : 存评论(待审)
D4 --> P31 : 评论ID
P31 --> E1 : 提交成功

E1 --> P32 : 选表情
P32 --> D5 : 存表情记录
D5 --> P32 : 反应统计
P32 --> E1 : 更新反应数

E3 --> P33 : 查看待审评论
P33 --> D4 : 查待审评论
D4 --> P33 : 待审列表
E3 --> P33 : 通过/屏蔽
P33 --> D4 : 更新状态
D4 --> P33 : 更新确认
P33 --> E3 : 审核结果
@enduml

